{
  "Cores": 4,
  "Production": "NO",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "connection": "Data Source=YOUR_SERVER; Initial Catalog=mangawebapi; Integrated Security=true;"
  },
  "DomainSettings": {
    "ImageUrl": "https://localhost:44311/Files/"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "https://localhost:44311/",
    "Audience": "https://localhost:44311/"
  },
  "MultimediaBaseUrl": "https://localhost:44311/Files/",
  "Captcha": {
    "Enabled": false,
    "SiteKey": "YOUR_RECAPTCHA_SITE_KEY",
    "Secret": "YOUR_RECAPTCHA_SECRET_KEY",
    "MinScore": 0.5
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "OurMangaSite",
    "SenderEmail": "your_email@gmail.com",
    "Username": "your_email@gmail.com",
    "Password": "YOUR_APP_PASSWORD",
    "EnableSsl": true,
    "FrontendResetUrl": "http://localhost:3000/reset-password"
  }
}
